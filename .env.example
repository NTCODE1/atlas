# Base URL of the atlas-api Cloudflare Worker.
# Copy this file to `.env` and set your deployed Worker URL.
VITE_HEALTH_API_URL=https://your-worker-url.workers.dev

# Low-privilege read/AI key the PWA sends to the Worker (must match the Worker's
# ATLAS_API_KEY secret). This is intentionally low-sensitivity: it only allows
# reading your data and rate-limited AI calls. The powerful Anthropic key lives
# ONLY in the Worker and is never placed here.
VITE_ATLAS_API_KEY=your-atlas-api-key
